#!/usr/bin/env sh
# Codemagic.yaml installs the official Gradle wrapper launcher/JAR from the
# Flutter SDK template before building. This fallback supports machines that
# already have Gradle installed when the wrapper JAR is not present.
set -eu
APP_HOME="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
WRAPPER_JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
if [ -f "$WRAPPER_JAR" ]; then
    if [ -n "${JAVA_HOME:-}" ]; then
        JAVACMD="$JAVA_HOME/bin/java"
    else
        JAVACMD="java"
    fi
    exec "$JAVACMD" ${JAVA_OPTS:-} -classpath "$WRAPPER_JAR" org.gradle.wrapper.GradleWrapperMain "$@"
fi
if command -v gradle >/dev/null 2>&1; then
    exec gradle "$@"
fi
echo "Gradle wrapper JAR is generated automatically by codemagic.yaml. Locally run: flutter create --platforms=android ." >&2
exit 1
